<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Categories - News CMS Admin</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="admin-wrap">
    <nav class="admin-nav">
      <span class="admin-logo">📰 News CMS Admin</span>
      <div class="admin-nav-links">
        <a href="/admin/dashboard">Posts</a>
        <a href="/admin/categories">Categories</a>
        <a href="/">All</a>
        <% categories.forEach(function(cat) { %>
          <a href="/category/<%= cat.slug %>"><%= cat.name %></a>
        <% }) %>
        <a href="/logout">Logout</a>
      </div>
    </nav>

    <div class="admin-content">
      <h1>Categories</h1>

      <% if (typeof error !== 'undefined' && error) { %>
        <p class="alert alert-error"><%= error %></p>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <p class="alert alert-success"><%= success %></p>
      <% } %>

      <form action="/admin/categories/new" method="POST" class="inline-add-form">
        <input type="text" name="name" placeholder="New category name" required>
        <button type="submit">Add Category</button>
      </form>

      <table class="admin-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Slug</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (categories.length === 0) { %>
            <tr><td colspan="3" class="empty">No categories yet.</td></tr>
          <% } else { %>
            <% categories.forEach(function(cat) { %>
              <tr>
                <td><%= cat.name %></td>
                <td><%= cat.slug %></td>
                <td class="actions">
                  <a href="/admin/categories/edit/<%= cat._id %>">Edit</a>
                  <form action="/admin/categories/delete/<%= cat._id %>" method="POST" class="inline-form">
                    <button type="submit" class="delete-btn" onclick="return confirm('Delete this category?')">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</body>
</html>